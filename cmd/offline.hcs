!! ------------------------------------------------------------------ adres powrotu
fun of_home_url() -> Str [
    !! wracamy na blue.html (adres zapisany przez guard), a nie na zwykla strone glowna
    let r = u_ls_get("hackeros_root_blue")
    if r != null and r != "" [
        end r
    ]
    let parts = location.pathname.split("/").filter(Boolean)
    let seg = ""
    if parts.len() > 0 [
        seg = parts[0]
    ]
    if location.hostname.endsWith(".github.io") and seg != "" and not str_ends_with(seg, ".html") [
        end location.origin + "/" + seg + "/blue.html"
    ]
    if str_ends_with(location.pathname, "offline.html") [
        end "blue.html"
    ]
    end location.href.split("?")[0].split("#")[0]
]

!! ------------------------------------------------------------------ test lacznosci
async fun of_probe() -> Bool [
    if of_preview [
        await of_sleep(600)
        end false
    ]
    if not navigator.onLine [
        end false
    ]
    if location.protocol == "file:" [
        end true
    ]
    let ctl = Reflect.construct(AbortController, [])
    let tm = set_timeout(ctl.abort.bind(ctl), 3500)
    !! parametr "probe" jest pomijany przez Service Worker -> zapytanie idzie prawdziwie do sieci
    let opts = u_obj("{\"method\":\"HEAD\",\"cache\":\"no-store\"}")
    opts.signal = ctl.signal
    let good = await fetch(location.pathname + "?probe=" + Date.now(), opts).then(of_true, of_false)
    clearTimeout(tm)
    end good
]

!! ------------------------------------------------------------------ render
fun of_render_last_online() [
    let raw = u_ls_get("hackeros_last_online")
    let ts = 0
    if raw != null [
        ts = Number(raw)
    ]
    if not Number.isFinite(ts) or ts <= 0 [
        of_last.textContent = of_tx_never()
        end 0
    ]
    let d = Reflect.construct(Date, [ts])
    let loc = "en-US"
    if of_lang == "pl" [
        loc = "pl-PL"
    ]
    let when = d.toLocaleTimeString(loc, u_obj("{\"hour\":\"2-digit\",\"minute\":\"2-digit\"}"))
    let min = Math.floor((Date.now() - ts) / 60000)
    let ago = of_tx_just_now()
    if min >= 1 [
        ago = of_tx_ago(min)
    ]
    of_last.innerHTML = of_tx_last_online(when, ago)
]

fun of_bar_width() -> Str [
    end (of_div(of_retry_every - of_countdown, of_retry_every) * 100) + "%"
]

fun of_render_offline() [
    u_cls_remove(of_card, "ok")
    of_title.textContent = of_tx_title(of_theme)
    of_desc.innerHTML = of_tx_desc(of_theme)
    let brand = "HackerOS Search"
    if of_theme == "blue" [
        brand = "Blue Search"
    ]
    document.title = brand + " | " + of_tx_title(of_theme)
    of_retry.textContent = of_tx_retry()
    of_bar.style.width = of_bar_width()
    of_render_last_online()
]

fun of_render_countdown() [
    if of_preview [
        of_status.textContent = of_tx_preview_status()
    ] else [
        of_status.textContent = of_tx_next_in(of_countdown)
    ]
    of_bar.style.width = of_bar_width()
]

fun of_after_restored() [
    !! otwarty jako osobna strona -> wracamy do wyszukiwarki; wstawiony w miejsce strony -> odswiezamy ja
    if str_ends_with(location.pathname, "offline.html") [
        location.replace(of_home_url())
    ] else [
        location.reload()
    ]
]

fun of_on_restored() [
    of_restored = true
    of_card.classList.add("ok")
    of_title.textContent = of_tx_restored_title()
    of_desc.innerHTML = of_tx_restored_desc()
    of_status.textContent = of_tx_restored_status()
    setTimeout(of_after_restored, 1300)
]

async fun of_reconnect() [
    if of_busy or of_restored [
        end 0
    ]
    of_busy = true
    of_retry.disabled = true
    of_status.textContent = of_tx_trying()
    let good = await of_probe()
    of_busy = false
    of_retry.disabled = false
    if good [
        of_on_restored()
        end 0
    ]
    of_countdown = of_retry_every
    of_render_countdown()
]

fun of_tick() [
    if of_busy or of_restored [
        end 0
    ]
    of_countdown = of_countdown - 1
    if of_countdown <= 0 [
        of_reconnect()
        end 0
    ]
    of_render_countdown()
    of_render_last_online()
]

fun of_on_retry_click(e) [
    of_countdown = 0
    of_reconnect()
]

fun of_on_keydown(e) [
    if (e.key == "r" or e.key == "R") and not e.ctrlKey and not e.metaKey [
        of_reconnect()
    ]
]

fun of_on_online(e) [
    of_reconnect()
]

!! ------------------------------------------------------------------ tlo (canvas) - osobne dla kazdego trybu
fun of_make_dots(n, h0, h1, sp) [
    let out: List<OfDot> = []
    let i = 0
    while i < n [
        out.push(OfDot(u_rnd(0, of_w), u_rnd(0, of_h), u_rnd(0 - sp, sp), u_rnd(0 - sp, sp), u_rnd(1, 2.4), u_rnd(h0, h1)))
        i = i + 1
    ]
    end out
]

fun of_init_scene() [
    let dpr = Math.min(window.devicePixelRatio or 1, 2)
    of_w = innerWidth
    of_h = innerHeight
    of_bg.width = of_w * dpr
    of_bg.height = of_h * dpr
    of_c.setTransform(dpr, 0, 0, dpr, 0, 0)
    of_stars = []
    of_dots = []
    of_drops = []
    if of_theme == "space" or of_theme == "blue" [
        let per = 5500
        let cap = 280
        if of_theme == "blue" [
            per = 2800
            cap = 520
        ]
        let n = Math.min(cap, Math.floor((of_w * of_h) / per))
        let i = 0
        while i < n [
            let r = u_rnd(0.3, 1.5)
            if of_theme == "blue" [
                r = u_rnd(0.3, 1.3)
            ]
            of_stars.push(OfStar(u_rnd(0, of_w), u_rnd(0, of_h), r, u_rnd(0, 6.28), u_rnd(0.4, 1.6), 0.01 + r * 0.02))
            i = i + 1
        ]
    ] elif of_theme == "matrix" [
        let cols = Math.ceil(of_w / of_fs)
        let i = 0
        while i < cols [
            of_drops.push(u_rnd(-40, 0))
            i = i + 1
        ]
    ] elif of_theme == "cyber" [
        of_dots = of_make_dots(36, 170, 310, 0.25)
    ] elif of_theme == "sunset" [
        of_dots = of_make_dots(40, 10, 45, 0.18)
    ] else [
        of_dots = of_make_dots(50, 200, 230, 0.15)
    ]
]

fun of_on_resize(e) [
    of_init_scene()
]

fun of_draw_dots(links: Bool, dist, step: Bool) [
    for p in of_dots [
        if step [
            p.x = p.x + p.vx
            p.y = p.y + p.vy
            if p.x < 0 or p.x > of_w [
                p.vx = p.vx * -1
            ]
            if p.y < 0 or p.y > of_h [
                p.vy = p.vy * -1
            ]
        ]
        of_c.fillStyle = "hsla(" + p.h + ",70%,60%,.55)"
        of_c.beginPath()
        of_c.arc(p.x, p.y, p.r, 0, 6.2832)
        of_c.fill()
    ]
    if not links [
        end 0
    ]
    of_c.lineWidth = 0.5
    let i = 0
    while i < of_dots.len() [
        let j = i + 1
        while j < of_dots.len() [
            let d = Math.hypot(of_dots[i].x - of_dots[j].x, of_dots[i].y - of_dots[j].y)
            if d < dist [
                of_c.strokeStyle = "hsla(" + of_dots[i].h + ",70%,60%," + ((1 - of_div(d, dist)) * 0.25) + ")"
                of_c.beginPath()
                of_c.moveTo(of_dots[i].x, of_dots[i].y)
                of_c.lineTo(of_dots[j].x, of_dots[j].y)
                of_c.stroke()
            ]
            j = j + 1
        ]
        i = i + 1
    ]
]

fun of_draw_stars(t, dt) [
    of_c.clearRect(0, 0, of_w, of_h)
    let rgb = "255,255,255"
    if of_theme == "blue" [
        rgb = "200,218,255"
    ]
    for s in of_stars [
        if not of_reduce [
            s.x = s.x - s.v * dt * 0.06 * 16
            if s.x < 0 [
                s.x = of_w
                s.y = u_rnd(0, of_h)
            ]
        ]
        let a = 0.7
        if not of_reduce [
            a = 0.35 + 0.65 * Math.abs(Math.sin(t * 0.001 * s.s + s.p))
        ]
        of_c.fillStyle = "rgba(" + rgb + "," + a + ")"
        of_c.beginPath()
        of_c.arc(s.x, s.y, s.r, 0, 6.2832)
        of_c.fill()
    ]
]

fun of_draw_matrix(dt) [
    of_matrix_acc = of_matrix_acc + dt
    if of_matrix_acc < 55 [
        end 0
    ]
    of_matrix_acc = 0
    of_c.fillStyle = "rgba(0,0,0,.10)"
    of_c.fillRect(0, 0, of_w, of_h)
    of_c.font = of_fs + "px monospace"
    let i = 0
    while i < of_drops.len() [
        let x = i * of_fs
        let y = of_drops[i] * of_fs
        if y > 0 [
            of_c.fillStyle = "rgba(0,255,102,.85)"
            of_c.fillText(of_mch[Math.floor(Math.random() * of_mch.len())], x, y - of_fs)
            of_c.fillStyle = "#d6ffe6"
            of_c.fillText(of_mch[Math.floor(Math.random() * of_mch.len())], x, y)
        ]
        if y > of_h and Math.random() > 0.975 [
            of_drops[i] = 0
        ]
        of_drops[i] = of_drops[i] + 1
        i = i + 1
    ]
]

fun of_draw_cyber(dt) [
    of_c.clearRect(0, 0, of_w, of_h)
    let hy = of_h * 0.58
    let sky = of_c.createLinearGradient(0, hy - 120, 0, hy)
    sky.addColorStop(0, "rgba(255,0,255,0)")
    sky.addColorStop(1, "rgba(255,0,255,.14)")
    of_c.fillStyle = sky
    of_c.fillRect(0, hy - 120, of_w, 120)
    if not of_reduce [
        of_grid_off = (of_grid_off + dt * 0.00035) % 1
    ]
    of_c.lineWidth = 1
    let rows = 14
    let k = 0
    while k < rows [
        let f = of_div(k + of_grid_off, rows)
        let y = hy + (of_h - hy) * f * f
        of_c.strokeStyle = "rgba(255,0,255," + (0.08 + f * 0.4) + ")"
        of_c.beginPath()
        of_c.moveTo(0, y)
        of_c.lineTo(of_w, y)
        of_c.stroke()
        k = k + 1
    ]
    let cols = 18
    let i = 0 - cols
    while i <= cols [
        of_c.strokeStyle = "rgba(0,255,255," + (0.12 + (1 - of_div(Math.abs(i), cols)) * 0.25) + ")"
        of_c.beginPath()
        of_c.moveTo(of_w / 2.0 + i * 14, hy)
        of_c.lineTo(of_w / 2.0 + i * of_div(of_w, cols) * 0.9, of_h)
        of_c.stroke()
        i = i + 1
    ]
    of_c.strokeStyle = "rgba(0,255,255,.7)"
    of_c.lineWidth = 1.5
    of_c.beginPath()
    of_c.moveTo(0, hy)
    of_c.lineTo(of_w, hy)
    of_c.stroke()
    of_draw_dots(true, 120, not of_reduce)
]

fun of_draw_sunset(t) [
    of_c.clearRect(0, 0, of_w, of_h)
    let r = Math.min(of_w, of_h) * 0.2
    let cx = of_w / 2.0
    let cy = of_h * 0.7
    let g = of_c.createLinearGradient(0, cy - r, 0, cy + r)
    g.addColorStop(0, "rgba(255,214,107,.75)")
    g.addColorStop(1, "rgba(255,77,141,.75)")
    of_c.fillStyle = g
    of_c.beginPath()
    of_c.arc(cx, cy, r, 0, 6.2832)
    of_c.fill()
    of_c.globalCompositeOperation = "destination-out"
    let sp = r * 0.2
    let shift = 0.0
    if not of_reduce [
        shift = (t * 0.012) % sp
    ]
    let j = 0
    while j < 9 [
        let y = cy + r * 0.05 + j * sp - shift + sp
        if y > cy and y < cy + r [
            of_c.fillRect(cx - r, y, r * 2, 2 + j * 1.6)
        ]
        j = j + 1
    ]
    of_c.globalCompositeOperation = "source-over"
    of_draw_dots(true, 100, not of_reduce)
]

fun of_frame(t) [
    !! po wstawieniu ekranu w miejsce innej strony stary canvas moze zniknac - wtedy konczymy petle
    if not of_bg.isConnected [
        end 0
    ]
    requestAnimationFrame(of_frame)
    let dt = t - of_prev_t
    if dt == 0 or Number.isNaN(dt) [
        dt = 16
    ]
    dt = Math.min(60, dt)
    of_prev_t = t
    if of_theme == "space" or of_theme == "blue" [
        of_draw_stars(t, dt)
    ] elif of_theme == "matrix" [
        of_draw_matrix(dt)
    ] elif of_theme == "cyber" [
        of_draw_cyber(dt)
    ] elif of_theme == "sunset" [
        of_draw_sunset(t)
    ] else [
        of_c.clearRect(0, 0, of_w, of_h)
        of_draw_dots(true, 110, not of_reduce)
    ]
]

!! ------------------------------------------------------------------ szkielet strony (head + body z offline.html)
fun of_build_head() [
    let head = document.head
    u_attrs(u_el(head, "meta", "", ""), ["name", "robots", "content", "noindex, nofollow"])
    !! znacznik rozpoznawany przez guard (odroznia ten plik od zwyklego bledu)
    u_attrs(u_el(head, "meta", "", ""), ["name", "hackeros-offline", "content", "blue"])
    u_attrs(u_el(head, "link", "", ""), ["rel", "icon", "type", "image/png", "href", "https://raw.githubusercontent.com/HackerOS-Linux-System/Blue-Environment/main/images/logo.png"])
]

fun of_svg_off() -> Str [
    end u_join(['<svg class="wifi-off" viewBox="0 0 24 24"><path d="M2 2l20 20"/><path d="M8.5 16.4a5 5 0 0 1 7 0"/>', '<path d="M2 8.8a15 15 0 0 1 4.2-2.6"/><path d="M10.7 5.1A15 15 0 0 1 22 8.8"/><path d="M5 12.9a10 10 0 0 1 5.2-2.7"/>', '<path d="M14 10.3a10 10 0 0 1 5 2.6"/><path d="M12 20h.01"/></svg>'])
]

fun of_svg_on() -> Str [
    end u_join(['<svg class="wifi-on" viewBox="0 0 24 24"><path d="M5 12.9a10 10 0 0 1 14 0"/><path d="M2 8.8a15 15 0 0 1 20 0"/>', '<path d="M8.5 16.4a5 5 0 0 1 7 0"/><path d="M12 20h.01"/></svg>'])
]

fun of_build_body() [
    let body = document.body
    of_bg = u_attrs(u_el(body, "canvas", "", ""), ["id", "bg", "aria-hidden", "true"])
    let overlay = u_attrs(u_el(body, "div", "overlay", ""), ["id", "offlineDialog", "role", "alertdialog", "aria-modal", "true", "aria-labelledby", "dlgTitle", "aria-describedby", "dlgDesc"])
    of_card = u_attrs(u_el(overlay, "div", "card", ""), ["id", "card"])
    let icon = u_attrs(u_el(of_card, "div", "icon", ""), ["aria-hidden", "true"])
    icon.innerHTML = of_svg_off() + of_svg_on()
    of_title = u_attrs(u_el(of_card, "h1", "", "Brak internetu"), ["id", "dlgTitle"])
    of_desc = u_attrs(u_el(of_card, "p", "desc", "Brak połączenia z internetem."), ["id", "dlgDesc"])
    let st = u_attrs(u_el(of_card, "div", "status", ""), ["role", "status", "aria-live", "polite"])
    of_status = u_attrs(u_el(st, "span", "", ""), ["id", "statusLine"])
    of_status.innerHTML = "&nbsp;"
    of_last = u_attrs(u_el(st, "span", "", ""), ["id", "lastOnline"])
    of_last.innerHTML = "&nbsp;"
    let bar = u_attrs(u_el(of_card, "div", "bar", ""), ["aria-hidden", "true"])
    of_bar = u_attrs(u_el(bar, "i", "", ""), ["id", "barFill"])
    let actions = u_el(of_card, "div", "actions", "")
    of_retry = u_attrs(u_el(actions, "button", "btn", "Spróbuj ponownie"), ["type", "button", "id", "retry"])
    let hint = u_attrs(u_el(of_card, "p", "hint", "Ta strona jest zapisana w pamięci przeglądarki i działa bez internetu."), ["id", "hint"])
    hint.textContent = of_tx_hint()
]

!! ------------------------------------------------------------------ start
fun main() [
    of_params = Reflect.construct(URLSearchParams, [location.search])
    of_preview = of_params.has("preview")
    if window.matchMedia [
        of_reduce = matchMedia("(prefers-reduced-motion: reduce)").matches
    ]
    of_lang = "en"
    if u_is_pl() [
        of_lang = "pl"
    ]

    !! motyw: ten ekran to Blue Edition; pozostale motywy tylko jako podglad (?preview&theme=matrix)
    of_theme = "blue"
    let q = u_call(of_params, "get", ["theme"])
    if q != null and of_is_theme(q) [
        of_theme = q
    ]

    of_build_head()
    of_build_body()
    document.body.classList.add("t-" + of_theme)
    document.documentElement.lang = of_lang

    of_c = of_bg.getContext("2d")
    setInterval(of_tick, 1000)
    of_retry.addEventListener("click", of_on_retry_click)
    document.addEventListener("keydown", of_on_keydown)
    window.addEventListener("online", of_on_online)

    of_init_scene()
    window.addEventListener("resize", of_on_resize)
    requestAnimationFrame(of_frame)
    of_render_offline()
    of_status.textContent = of_tx_checking()
    of_retry.focus()
    of_reconnect()
]
