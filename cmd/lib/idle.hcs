fun idle_crack_svg() -> Str [
    end '<svg viewBox="0 0 52 52"><path d="M21 21 L4 8 M21 21 L46 14 M21 21 L40 44 M21 21 L8 40 M21 21 L26 2" stroke="rgba(255,255,255,.75)" stroke-width="1.4" fill="none" stroke-linecap="round"/></svg>'
]

!!! Wykonuje `fn` ze sceny, o ile nie zostala anulowana.
fun idle_run_guard(scene, fn) [
    if not scene.cancelled [
        fn()
    ]
]

fun idle_after(scene, ms, fn) [
    scene.timers.push(window.setTimeout(idle_run_guard.bind(null, scene, fn), ms))
]

fun idle_pun_exec(scene, res, rej) [
    scene.finish = res
]

fun idle_pun_enter(scene) [
    scene.dim.classList.add("on")
    scene.man.classList.add("up")
]

fun idle_pun_locate(scene) [
    let r = scene.man.getBoundingClientRect()
    scene.mx = r.left + r.width * idle_muzzle_x
    scene.my = r.top + r.height * idle_muzzle_y
    let fs = u_clamp(r.height * 0.34, 90, 240)
    scene.flash.style.width = fs + "px"
    scene.flash.style.height = fs + "px"
    scene.flash.style.left = (scene.mx - fs / 2.0) + "px"
    scene.flash.style.top = (scene.my - fs / 2.0) + "px"
]

fun idle_pun_flash_off(scene) [
    scene.flash.style.opacity = "0"
    scene.man.style.transform = ""
]

!!! Po dotarciu pocisku: pekniecie na ekranie.
fun idle_pun_grow_done(scene, tr, tx, ty, v) [
    tr.remove()
    if scene.cancelled [
        end 0
    ]
    let hit = document.createElement("div")
    hit.className = "hos-hit"
    hit.style.left = tx + "px"
    hit.style.top = ty + "px"
    hit.innerHTML = idle_crack_svg()
    scene.layer.append(hit)
    let kf = u_obj("[{\"transform\":\"scale(.4)\",\"opacity\":1},{\"transform\":\"scale(1.7)\",\"opacity\":0}]")
    let op = u_obj("{\"duration\":520,\"easing\":\"ease-out\",\"fill\":\"forwards\"}")
    hit.animate(kf, op).finished.then(hit.remove.bind(hit), u_noop)
    end 0
]

fun idle_pun_shoot(scene) [
    !! blysk z lufy + drgniecie postaci
    scene.flash.style.opacity = "1"
    scene.flash.style.transform = "scale(" + u_rnd(0.8, 1.25).toFixed(2) + ") rotate(" + Math.floor(u_rnd(0, 90)) + "deg)"
    scene.man.style.transform = "translate(calc(-50% + " + u_rnd(-3, 3).toFixed(1) + "px), " + u_rnd(0, 5).toFixed(1) + "px)"
    idle_after(scene, 55, idle_pun_flash_off.bind(null, scene))
    !! pocisk leci w strone ekranu
    let tx = u_rnd(innerWidth * 0.05, innerWidth * 0.95)
    let ty = u_rnd(innerHeight * 0.05, innerHeight * 0.72)
    let dx = tx - scene.mx
    let dy = ty - scene.my
    let len = Math.hypot(dx, dy)
    let tr = document.createElement("div")
    tr.className = "hos-tracer"
    tr.style.left = scene.mx + "px"
    tr.style.top = scene.my + "px"
    tr.style.width = len + "px"
    tr.style.transform = "rotate(" + Math.atan2(dy, dx) + "rad)"
    scene.layer.append(tr)
    let kf = u_obj("[{\"clipPath\":\"inset(0 100% 0 0)\"},{\"clipPath\":\"inset(0 0 0 0)\"}]")
    let op = u_obj("{\"duration\":120,\"easing\":\"ease-in\",\"fill\":\"forwards\"}")
    let grow = tr.animate(kf, op)
    grow.finished.then(idle_pun_grow_done.bind(null, scene, tr, tx, ty), u_noop)
]

fun idle_pun_leave(scene) [
    u_cls_remove(scene.man, "up")
    u_cls_remove(scene.dim, "on")
]

fun idle_pun_end(scene) [
    idle_dispose(scene.layer, false)
    let f = scene.finish
    f(null)
]

fun idle_punisher_scene() [
    let layer = idle_make_layer()
    let dim = document.createElement("div")
    dim.className = "hos-dim"
    let man = document.createElement("div")
    man.className = "hos-gunman"
    let h = u_clamp(innerHeight * 0.82, 280, 700)
    man.style.height = h + "px"
    man.innerHTML = idle_gunman_svg()
    let flash = document.createElement("div")
    flash.className = "hos-flash"
    layer.append(dim, man, flash)

    let scene = idle_new_scene("punisher", layer)
    scene.dim = dim
    scene.man = man
    scene.flash = flash
    scene.done = Reflect.construct(Promise, [idle_pun_exec.bind(null, scene)])

    !! wjazd
    requestAnimationFrame(idle_pun_enter.bind(null, scene))

    !! harmonogram: wjazd -> 4 serie -> zjazd
    let t = 800
    idle_after(scene, t, idle_pun_locate.bind(null, scene))
    t = t + 100
    for burst in range(0, 4) [
        let shots = 6 + Math.floor(Math.random() * 5)
        for s in range(0, shots) [
            idle_after(scene, t + s * 95, idle_pun_shoot.bind(null, scene))
        ]
        t = t + shots * 95 + 650
    ]
    idle_after(scene, t, idle_pun_leave.bind(null, scene))
    idle_after(scene, t + 800, idle_pun_end.bind(null, scene))
    end scene
]

!!! ---------------------------------------------------------------- licznik bezczynnosci

fun idle_offline_shown() -> Bool [
    end document.getElementById("offlineDialog") != null
]

fun idle_scene_end(id, v) [
    if idle_cur_id == id [
        idle_cur = null
        idle_cur_id = 0
        idle_previewing = false
    ]
    end 0
]

fun idle_play(name: Str, preview: Bool) [
    if idle_cur_id != 0 or idle_offline_shown() or document.body == null [
        end 0
    ]
    idle_previewing = preview
    let scene = null
    if name == "ufo" [
        scene = idle_ufo_scene()
    ] elif name == "punisher" [
        scene = idle_punisher_scene()
    ] else [
        scene = idle_plane_scene()
    ]
    idle_cur = scene
    idle_cur_id = scene.id
    scene.done.then(idle_scene_end.bind(null, scene.id))
    end 0
]

fun idle_activity(e) [
    idle_last = Date.now()
    idle_stage = 0
    if idle_cur_id != 0 and not idle_previewing [
        idle_cancel(idle_cur)
        idle_cur = null
        idle_cur_id = 0
    ]
]

!!! Powrot na karte = aktywnosc (licznik nie "dolicza" czasu spedzonego w innej karcie).
fun idle_on_visibility(e) [
    if not document.hidden [
        idle_activity(null)
    ]
]

fun idle_tick() [
    if document.hidden or idle_cur_id != 0 or idle_stage >= idle_order.len() [
        end 0
    ]
    if Date.now() - idle_last >= idle_step * (idle_stage + 1) [
        let name = idle_order[idle_stage]
        idle_play(name, false)
        idle_stage = idle_stage + 1
    ]
    end 0
]

fun idle_demo_start(name: Str) [
    idle_play(name, true)
]

fun idle_init() [
    let params = Reflect.construct(URLSearchParams, [location.search])
    let q = u_call(params, "get", ["idle"])
    let demo = ""
    if q != null [
        for n in idle_order [
            if n == q [
                demo = n
            ]
        ]
    ]
    idle_step = idle_default_step
    if q != null and demo == "" [
        let sec = Number(q)
        if Number.isFinite(sec) and sec >= 1 [
            idle_step = sec * 1000
        ]
    ]

    idle_last = Date.now()
    idle_stage = 0
    idle_cur = null
    idle_cur_id = 0
    idle_previewing = false

    let events = ["mousemove", "mousedown", "keydown", "touchstart", "wheel", "scroll", "pointerdown"]
    for ev in events [
        window.addEventListener(ev, idle_activity, u_obj("{\"passive\":true,\"capture\":true}"))
    ]
    document.addEventListener("visibilitychange", idle_on_visibility)
    setInterval(idle_tick, 1000)

    if demo != "" [
        window.setTimeout(idle_demo_start.bind(null, demo), 600)
    ]
]
