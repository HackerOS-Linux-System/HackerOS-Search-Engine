use <lang:javascript>

!!! scripts/build.hcs - buduje cala strone HackerOS Search do `dist/` (zastepuje scripts/build.ts).
!!!
!!! Uruchomienie (przez bit, patrz Bit.hk):
!!!     bit site
!!! czyli:
!!!     hackerc build scripts/build.hcs -o cache/site-build.js && node cache/site-build.js
!!!
!!! Zmienne srodowiskowe:
!!!     HACKERC     sciezka do binarki hackerc (domyslnie `hackerc` z PATH)
!!!     GITHUB_SHA  identyfikator buildu (domyslnie czas) - nazwa cache Service Workera
!!!
!!! Co powstaje w dist/:
!!!     index.html + script.js   <- cmd/main.hcs      (strona glowna: czastki, motywy, offline, bezczynnosc)
!!!     blue.html  + blue.js     <- cmd/blue.hcs      (ukryta podstrona Blue Edition)
!!!     404.html                 <- cmd/page404.hcs   (ekran offline zwyklej strony + 404; JS INLINE)
!!!     offline.html             <- cmd/offline.hcs   (ekran offline Blue Edition; JS INLINE)
!!!     sw.js                    <- cmd/sw.hcs        (Service Worker, lang:javascript)
!!!     LICENSE, .nojekyll
!!!
!!! Strony 404.html i offline.html musza dzialac w pelni samodzielnie (takze bez internetu i pod
!!! dowolna sciezka), dlatego ich app.js jest wklejany do HTML-a. Reszta dostaje zewnetrzny plik .js.

let sb_fs = require("fs")
let sb_cp = require("child_process")

let sb_hackerc = process.env.HACKERC or "hackerc"
let sb_build_id = String(process.env.GITHUB_SHA or Date.now().toString(36)).slice(0, 8)
let sb_dist = "dist"
let sb_tmp = "cache/site"
let sb_tag = "<script src=\"app.js\"></script>"

fun sb_sh(cmd: Str) [
    sb_cp.execSync(cmd, JSON.parse("{\"stdio\":\"inherit\"}"))
]

fun sb_fail(msg: Str) [
    console.error("build: " + msg)
    process.exit(1)
]

fun sb_read(path: Str) -> Str [
    end sb_fs.readFileSync(path, "utf8")
]

fun sb_write(path: Str, text: Str) [
    sb_fs.writeFileSync(path, text)
]

!!! Buduje jedna strone: hackerc -> cache/site/<name>/{index.html,app.js} -> dist/.
!!! `js_name` pusty = JS wklejany inline, inaczej zapisywany jako dist/<js_name>.
fun sb_page(src: Str, name: Str, html_name: Str, js_name: Str, title: Str) [
    let out = sb_tmp + "/" + name
    sb_sh(sb_hackerc + " build " + src + " -o " + out)
    let html = sb_read(out + "/index.html")
    !! caly app.js w funkcji: runtime hackerc deklaruje `class HksOption` itd. w zasiegu globalnym, a ekran
    !! offline jest wstawiany przez document.write() do tego samego okna (guard) - bez tego drugi skrypt
    !! konczylby sie bledem "Identifier 'HksOption' has already been declared".
    let js = "(function () {\n" + sb_read(out + "/app.js") + "\n})();\n"
    if not str_contains(html, sb_tag) [
        sb_fail(src + ": brak znacznika " + sb_tag + " w wygenerowanym index.html")
    ]
    !! tytul z nazwy pliku wejsciowego zastepujemy prawdziwym (strona i tak ustawia go w JS)
    html = str_replace(html, "<title>" + name + "</title>", "<title>" + title + "</title>")
    let script = ""
    if js_name == "" [
        script = "<script>" + str_replace(js, "</script", "<\\/script") + "</script>"
    ] else [
        script = "<script src=\"" + js_name + "\"></script>"
        sb_write(sb_dist + "/" + js_name, js)
    ]
    sb_write(sb_dist + "/" + html_name, str_replace(html, sb_tag, script))
    if js_name == "" [
        console.log("build: " + html_name + " (JS inline)")
    ] else [
        console.log("build: " + html_name + " + " + js_name)
    ]
]

fun main() [
    sb_fs.rmSync(sb_dist, JSON.parse("{\"recursive\":true,\"force\":true}"))
    sb_fs.rmSync(sb_tmp, JSON.parse("{\"recursive\":true,\"force\":true}"))
    sb_fs.mkdirSync(sb_dist, JSON.parse("{\"recursive\":true}"))
    sb_fs.mkdirSync(sb_tmp, JSON.parse("{\"recursive\":true}"))

    !! 1) strony HTML (hackerc, use <mode:website>)
    sb_page("cmd/main.hcs", "main", "index.html", "script.js", "HackerOS Search")
    sb_page("cmd/blue.hcs", "blue", "blue.html", "blue.js", "Blue Search")
    sb_page("cmd/page404.hcs", "page404", "404.html", "", "HackerOS Search | Offline")
    sb_page("cmd/offline.hcs", "offline", "offline.html", "", "Blue Search | Offline")

    !! 2) Service Worker (hackerc, use <lang:javascript>) + identyfikator buildu
    sb_sh(sb_hackerc + " build cmd/sw.hcs -o " + sb_dist + "/sw.js")
    let sw = sb_read(sb_dist + "/sw.js")
    if not str_contains(sw, "__BUILD_ID__") [
        sb_fail("sw.js: brak znacznika __BUILD_ID__")
    ]
    sb_write(sb_dist + "/sw.js", str_replace(sw, "__BUILD_ID__", sb_build_id))
    console.log("build: sw.js (cache hackeros-search-" + sb_build_id + ")")

    !! 3) pliki statyczne; GitHub Pages: wylacz Jekyll
    if sb_fs.existsSync("LICENSE") [
        sb_fs.copyFileSync("LICENSE", sb_dist + "/LICENSE")
    ]
    sb_write(sb_dist + "/.nojekyll", "")

    !! 4) kontrola wyniku
    let required = ["index.html", "script.js", "blue.html", "blue.js", "404.html", "offline.html", "sw.js"]
    for f in required [
        if not sb_fs.existsSync(sb_dist + "/" + f) [
            sb_fail("brak pliku dist/" + f)
        ]
    ]
    console.log("Build OK (id: " + sb_build_id + ") -> " + sb_dist)
]
